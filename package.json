{
  "name": "cozy-builder",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A 3D cozy hex-grid village builder with an automatically lively world.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.185.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.185.0",
    "@vitejs/plugin-react": "^6.0.4",
    "playwright": "^1.62.0",
    "typescript": "^5.9.0",
    "vite": "^8.1.5",
    "vitest": "^3.2.4"
  }
}
